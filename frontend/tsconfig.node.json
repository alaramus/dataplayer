{
  "extends": "@tsconfig/node22/tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "vitest.setup.ts",
    "playwright.config.ts",
    "openapi-ts.config.ts",
    "tests/**/*",
    // The end-to-end tests are typed against the generated client, the same
    // one the application uses: a scenario that reads an operation says what
    // an operation is by importing it rather than by describing it again.
    // Listed here because a composite project checks only the files it names,
    // and an imported file that no project claims is an error of its own.
    "src/client/**/*",
    // These run under vitest with the rest of `src`, but read the disk;
    // excluded from tsconfig.build.json for the reason given there.
    "src/shared/ui/declared.spec.ts",
    "src/shared/ui/contrast.spec.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    // The end-to-end tests run code inside the browser through page.evaluate,
    // so the files checked here speak of `document` as well as of Node.
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"]
  }
}
