    "@codemirror/view": "^6.43.9",
    "@quasar/extras": "^1.17.0",
    "@tanstack/vue-query": "^5.101.4",
    "@tanstack/vue-table": "9.2.3",
    "@vscode/markdown-it-katex": "^1.1.2",
    "axios": "1.18.0",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.14",
