# Copy this file to frontend/.env for development. It is intentionally not
# tracked by git. Running DataPlayer from compose.prod.yml does not need it:
# the built interface calls the API on the address it was opened from.

# Base URL of the backend API.
VITE_API_URL=http://localhost:8000

# Used by the Playwright helpers.
MAILCATCHER_HOST=http://localhost:1080
