# Dependencies point one way. Stated as a decision since sub-project 2a and
# unenforced until now: the check found app.core importing app.users on its
# first run, in the very refactor whose point was this rule.
[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:layers]
name = Layers point inward
type = layers
layers =
    app.api
    app.system
    app.metrics
    app.shares
    app.queries
    app.services
    app.source_operations
    app.jobs
    app.connectors
    app.adapters
    app.realtime
    app.users
    app.core
exhaustive = false

[importlinter:contract:core-knows-nobody]
name = core depends on nothing else in the application
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.users
    app.realtime
    app.adapters
    app.connectors
    app.queries
    app.services
    app.source_operations
    app.jobs
    app.shares
    app.system
    app.metrics
    app.api

# psycopg_pool is named separately from psycopg: it is a different
# distribution, so a rule that only said "psycopg" would let the pool leak into
# the rest of the application unnoticed. sqlglot is here for the same reason
# and not because it is a driver: the dialect that decides where a statement
# ends belongs to the source whose dialect it is, so a query module tempted to
# parse SQL itself fails this check instead.
[importlinter:contract:driver-sdk-is-contained]
name = the psycopg driver and the SQL dialect are imported only by the postgres adapter
type = forbidden
source_modules =
    app.core
    app.users
    app.realtime
    app.connectors
    app.queries
    app.services
    app.source_operations
    app.jobs
    app.shares
    app.system
    app.metrics
    app.api
    app.adapters.registry
    app.adapters.protocol
    app.adapters.catalog
    app.adapters.fetch
    app.adapters.routes
    app.adapters.actions
    app.adapters.operations
    app.adapters.resources
    app.adapters.file
    app.adapters.table_design
    app.adapters.expressions
forbidden_modules =
    psycopg
    psycopg_pool
    sqlglot

# The same rule as the psycopg one, for the three libraries the file source
# reads with: a format's library belongs to the module that owns the format, so
# an upgrade has one place to change. duckdb is here for a second reason as
# well — it is a SQL engine, and a query module tempted to parse or run SQL
# itself fails this check instead.
[importlinter:contract:file-format-sdks-are-contained]
name = pyarrow, openpyxl and duckdb are imported only by the file adapter
type = forbidden
source_modules =
    app.core
    app.users
    app.realtime
    app.connectors
    app.queries
    app.services
    app.source_operations
    app.jobs
    app.shares
    app.system
    app.metrics
    app.api
    app.adapters.registry
    app.adapters.protocol
    app.adapters.catalog
    app.adapters.cells
    app.adapters.dataset
    app.adapters.fetch
    app.adapters.relation
    app.adapters.routes
    app.adapters.actions
    app.adapters.operations
    app.adapters.resources
    app.adapters.postgres
forbidden_modules =
    pyarrow
    openpyxl
    duckdb

# The Redis client, by the same rule as psycopg and the file formats: the
# library of a source lives in the package that owns that source, so an
# upgrade has one place to change.
[importlinter:contract:redis-sdk-is-contained]
name = the redis client is imported only by the redis adapter
type = forbidden
source_modules =
    app.core
    app.users
    app.realtime
    app.connectors
    app.queries
    app.services
    app.source_operations
    app.jobs
    app.shares
    app.system
    app.metrics
    app.api
    app.adapters.registry
    app.adapters.protocol
    app.adapters.catalog
    app.adapters.fetch
    app.adapters.routes
    app.adapters.actions
    app.adapters.operations
    app.adapters.resources
    app.adapters.file
    app.adapters.postgres
forbidden_modules =
    redis

# Infrastructure Redis remains a cache rather than becoming a second state
# store by convenience. Jobs, queries, services and shares may use the generic
# cache contract where D31 calls for invalidation, but may not depend on its
# concrete Redis implementation or driver surface (D104).
[importlinter:contract:redis-cache-is-not-coordination]
name = jobs, queries, services, source operations, shares and metrics do not use infrastructure Redis
type = forbidden
source_modules =
    app.metrics
    app.jobs
    app.queries
    app.services
    app.source_operations
    app.shares
forbidden_modules =
    app.adapters.redis.cache
    app.adapters.redis.cache_connection
