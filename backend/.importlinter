# Dependencies point one way. Stated as a decision since sub-project 2a and
# unenforced until now: the check found app.core importing app.users on its
# first run, in the very refactor whose point was this rule.
[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:layers]
name = Layers point inward
type = layers
layers =
    app.api
    app.system
    app.ai
    app.metrics
    app.shares
    app.queries
    app.services
    app.source_operations
    app.pipelines
    app.transfers
    app.jobs
    app.terminals
    app.connectors
    app.adapters
    app.guide
    app.realtime
    app.users
    app.core
exhaustive = false

[importlinter:contract:core-knows-nobody]
name = core depends on nothing else in the application
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.users
    app.realtime
    app.adapters
    app.guide
    app.connectors
    app.queries
    app.services
    app.source_operations
    app.pipelines
    app.transfers
    app.jobs
    app.shares
    app.system
    app.metrics
    app.ai
    app.terminals
    app.api

# psycopg_pool is named separately from psycopg: it is a different
# distribution, so a rule that only said "psycopg" would let the pool leak into
# the rest of the application unnoticed. sqlglot is here for the same reason
# and not because it is a driver: the dialect that decides where a statement
# ends belongs to the source whose dialect it is, so a query module tempted to
# parse SQL itself fails this check instead.
[importlinter:contract:driver-sdk-is-contained]
name = the psycopg driver and the SQL dialect are imported only by the postgres adapter
type = forbidden
source_modules =
    app.core
    app.users
    app.realtime
    app.connectors
    app.queries
    app.services
    app.source_operations
    app.pipelines
    app.transfers
    app.jobs
    app.shares
    app.system
    app.metrics
    app.ai
    app.api
    app.adapters.registry
    app.adapters.protocol
    app.adapters.catalog
    app.adapters.fetch
    app.adapters.routes
    app.adapters.actions
    app.adapters.operations
    app.adapters.resources
    app.adapters.file
    app.adapters.explorer
    app.adapters.table_design
    app.adapters.expressions
forbidden_modules =
    psycopg
    psycopg_pool
    sqlglot

# The same rule as the psycopg one, for the three libraries the file explorer
# reads with: a format's library belongs to the module that owns the format, so
# an upgrade has one place to change, and every source that is a tree of files
# reads formats through the explorer rather than on its own (D150). duckdb is
# here for a second reason as well — it is a SQL engine, and a query module
# tempted to parse or run SQL itself fails this check instead.
[importlinter:contract:file-format-sdks-are-contained]
name = pyarrow, openpyxl and duckdb are imported only by the file explorer
type = forbidden
source_modules =
    app.core
    app.users
    app.realtime
    app.connectors
    app.queries
    app.services
    app.source_operations
    app.pipelines
    app.transfers
    app.jobs
    app.shares
    app.system
    app.metrics
    app.api
    app.adapters.registry
    app.adapters.protocol
    app.adapters.catalog
    app.adapters.cells
    app.adapters.dataset
    app.adapters.fetch
    app.adapters.relation
    app.adapters.routes
    app.adapters.actions
    app.adapters.operations
    app.adapters.resources
    app.adapters.postgres
forbidden_modules =
    pyarrow
    openpyxl
    duckdb

# The Redis client, by the same rule as psycopg and the file formats: the
# library of a source lives in the package that owns that source, so an
# upgrade has one place to change.
[importlinter:contract:redis-sdk-is-contained]
name = the redis client is imported only by the redis adapter
type = forbidden
source_modules =
    app.core
    app.users
    app.realtime
    app.connectors
    app.queries
    app.services
    app.source_operations
    app.pipelines
    app.transfers
    app.jobs
    app.shares
    app.system
    app.metrics
    app.api
    app.adapters.registry
    app.adapters.protocol
    app.adapters.catalog
    app.adapters.fetch
    app.adapters.routes
    app.adapters.actions
    app.adapters.operations
    app.adapters.resources
    app.adapters.file
    app.adapters.explorer
    app.adapters.postgres
forbidden_modules =
    redis

# Infrastructure Redis remains a cache rather than becoming a second state
# store by convenience. Jobs, queries, services and shares may use the generic
# cache contract where D31 calls for invalidation, but may not depend on its
# concrete Redis implementation or driver surface (D104).
[importlinter:contract:redis-cache-is-not-coordination]
name = jobs, queries, services, source operations, pipelines, transfers, shares and metrics do not use infrastructure Redis
type = forbidden
source_modules =
    app.metrics
    app.jobs
    app.queries
    app.services
    app.source_operations
    app.pipelines
    app.transfers
    app.shares
forbidden_modules =
    app.adapters.redis.cache
    app.adapters.redis.cache_connection

# The agent's framework stays inside the agent (D139): the rest of the
# application sees its run, step and message models, never LangChain's, so an
# upgrade of a framework that changes often has one package to change. Direct
# imports only: reaching LangChain through app.ai is what the package is for,
# and the layers keep everything below it from reaching app.ai at all.
[importlinter:contract:agent-framework-is-contained]
name = LangChain and LangGraph are imported only by the agent package
type = forbidden
allow_indirect_imports = True
source_modules =
    app.core
    app.users
    app.realtime
    app.adapters
    app.connectors
    app.queries
    app.services
    app.source_operations
    app.pipelines
    app.transfers
    app.jobs
    app.shares
    app.system
    app.metrics
    app.api
forbidden_modules =
    langchain
    langchain_core
    langgraph
    langchain_openai
    langchain_anthropic
    langchain_google_genai
    langchain_deepseek

# Inside the agent, a provider's SDK belongs to the module named after it, by
# the rule that keeps psycopg in its adapter. Direct imports only: every module
# reaches the providers through the factory in app.ai.providers.
[importlinter:contract:provider-sdks-are-contained]
name = provider SDKs are imported only by their provider modules
type = forbidden
allow_indirect_imports = True
source_modules =
    app.ai.catalog
    app.ai.checkpoints
    app.ai.content
    app.ai.conversations
    app.ai.models
    app.ai.preferences
    app.ai.prompts
    app.ai.routes
    app.ai.runner
    app.ai.topic
    app.ai.providers.failures
forbidden_modules =
    langchain_openai
    langchain_anthropic
    langchain_google_genai
    langchain_deepseek
    openai
    anthropic
    google
# The SSH library, by the rule psycopg follows: a source's library lives in the
# package that owns the source. Direct imports only: the store of keys reaches
# the library through `app.adapters.ssh.keys`, which exists for that (D146).
[importlinter:contract:ssh-sdk-is-contained]
name = asyncssh is imported only by the ssh adapter
type = forbidden
allow_indirect_imports = True
source_modules =
    app.core
    app.users
    app.realtime
    app.connectors
    app.queries
    app.services
    app.source_operations
    app.pipelines
    app.transfers
    app.jobs
    app.shares
    app.system
    app.metrics
    app.ai
    app.terminals
    app.api
    app.adapters.registry
    app.adapters.protocol
    app.adapters.catalog
    app.adapters.credentials
    app.adapters.terminal
    app.adapters.fetch
    app.adapters.routes
    app.adapters.actions
    app.adapters.operations
    app.adapters.resources
    app.adapters.file
    app.adapters.explorer
    app.adapters.postgres
    app.adapters.redis
forbidden_modules =
    asyncssh
