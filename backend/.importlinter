# Dependencies point one way. Stated as a decision since sub-project 2a and
# unenforced until now: the check found app.core importing app.users on its
# first run, in the very refactor whose point was this rule.
[importlinter]
root_package = app
include_external_packages = True

[importlinter:contract:layers]
name = Layers point inward
type = layers
layers =
    app.api
    app.system
    app.shares
    app.connectors
    app.adapters
    app.realtime
    app.users
    app.core
exhaustive = false

[importlinter:contract:core-knows-nobody]
name = core depends on nothing else in the application
type = forbidden
source_modules =
    app.core
forbidden_modules =
    app.users
    app.realtime
    app.adapters
    app.connectors
    app.shares
    app.system
    app.api

# psycopg_pool is named separately from psycopg: it is a different
# distribution, so a rule that only said "psycopg" would let the pool leak into
# the rest of the application unnoticed.
[importlinter:contract:driver-sdk-is-contained]
name = the psycopg driver is imported only by the postgres adapter
type = forbidden
source_modules =
    app.core
    app.users
    app.realtime
    app.connectors
    app.shares
    app.system
    app.api
    app.adapters.registry
    app.adapters.protocol
    app.adapters.catalog
    app.adapters.fetch
    app.adapters.routes
    app.adapters.actions
    app.adapters.resources
    app.adapters.file
forbidden_modules =
    psycopg
    psycopg_pool

# The same rule as the psycopg one, for the two libraries that read a columnar
# file and a workbook: a format's library belongs to the module that owns the
# format, so an upgrade has one place to change.
[importlinter:contract:file-format-sdks-are-contained]
name = pyarrow and openpyxl are imported only by the file adapter
type = forbidden
source_modules =
    app.core
    app.users
    app.realtime
    app.connectors
    app.shares
    app.system
    app.api
    app.adapters.registry
    app.adapters.protocol
    app.adapters.catalog
    app.adapters.cells
    app.adapters.dataset
    app.adapters.fetch
    app.adapters.relation
    app.adapters.routes
    app.adapters.actions
    app.adapters.resources
    app.adapters.postgres
forbidden_modules =
    pyarrow
    openpyxl
