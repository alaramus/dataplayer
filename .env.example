# Copy this file to .env and replace every placeholder before running anything.
# .env is intentionally not tracked by git.

# Enables development behaviour for commands that import the app directly
FASTAPI_ENV=development

PROJECT_NAME="DataPlayer"

# Signs JWT access tokens. Rotating it only logs everyone out.
SECRET_KEY=changethis

# Encrypts connector credentials at rest: urlsafe base64 of exactly 32 bytes.
# Kept separate from SECRET_KEY because rotating it requires migrating the
# stored secrets, while rotating SECRET_KEY does not.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CONNECTOR_SECRET_KEY=changethis

# Encrypts what people write in query documents, and the text an execution
# ran: urlsafe base64 of exactly 32 bytes. Separate again, because changing it
# without migrating the stored content makes every document unreadable.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
QUERY_CONTENT_KEY=changethis

# Holds one directory per user; a file connector never reaches outside it.
USER_STORAGE_ROOT=/data/users

# Ceiling for a single upload, in bytes. Counted as the bytes arrive.
MAX_UPLOAD_BYTES=104857600

# Connections kept between requests, per process. A source with no connection
# at all — the file storage — ignores these.
POOL_MAX_SIZE=5
POOL_MAX_POOLS=20
POOL_MAX_IDLE_SECONDS=300

# Maximum cached catalog levels and fetch pages: per backend process in memory,
# or shared by the deployment in Redis. Sources choose their TTL independently.
DATA_CACHE_MAX_ENTRIES=512

# Shared read cache is optional. Memory is correct for one backend process and
# remains the default. To enable the Compose service, run with the
# `shared-cache` profile, set backend to redis and uncomment a URL and key.
DATA_CACHE_BACKEND=memory
DATA_CACHE_DEPLOYMENT=development
DATA_CACHE_REDIS_TIMEOUT_SECONDS=1
# Local authenticated example (URL-encode special password characters):
# DATA_CACHE_REDIS_PASSWORD=development-cache-only
# DATA_CACHE_REDIS_URL=redis://:development-cache-only@redis-cache:6379/0
# External TLS + ACL example:
# DATA_CACHE_REDIS_URL=rediss://cache-user:password@cache.example.com:6380/0
# urlsafe base64 of exactly 32 bytes, used only for disposable cache values.
# DATA_CACHE_SECRET_KEY=

# Starting services on this machine. Off by default: a server that can reach a
# container runtime can do to the host whatever that runtime can.
SERVICES_ENABLED=false
DOCKER_SOCKET=/var/run/docker.sock
# The network a started service joins, and on which this server reaches it by
# container name. In development it is the one this compose project makes.
SERVICE_NETWORK=
# What one service may take of the machine, and how many one person may have.
SERVICE_MEMORY_MB=1024
SERVICE_CPUS=1.0
SERVICE_PIDS_LIMIT=512
SERVICE_MAX_PER_USER=5
# The named volume personal storage lives in; without it, backups are not
# offered, because a program in a container has nowhere to write one.
SERVICE_STORAGE_VOLUME=

# How long a socket may stay open without saying who it is.
WS_AUTH_TIMEOUT_SECONDS=5
# Watching the state of a user's connections: how often, how long a probe may
# take, how many at once, how far the wait grows after a failure, and how long
# the monitor outlives the last socket.
HEALTH_INTERVAL_SECONDS=15
HEALTH_PROBE_TIMEOUT_SECONDS=5
HEALTH_CONCURRENCY=8
HEALTH_BACKOFF_CAP_SECONDS=120
HEALTH_GRACE_SECONDS=5

FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# Email
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
