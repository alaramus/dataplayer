# Copy this file to .env and replace every placeholder before running anything.
# .env is intentionally not tracked by git.

# --- Mode: what `docker compose up` starts. Keep exactly one COMPOSE_FILE. ---
COMPOSE_PATH_SEPARATOR=,

# Development: hot reload, sample data and connections, the interface from
# `bun run dev` on http://localhost:5173, Adminer, Mailcatcher, a test Redis
# and SSH server. Also needs frontend/.env.
COMPOSE_FILE=compose.yml,compose.override.yml

# Running it for use: the built interface and the API together on APP_PORT,
# no samples, no helpers, restarted after a reboot. Set FRONTEND_HOST below
# to the address people open, and comment out FASTAPI_ENV.
# COMPOSE_FILE=compose.yml,compose.prod.yml
# APP_PORT=8000

# The address people open the interface at: links in e-mails point here, and
# it is the one origin the API accepts calls from. Development serves the
# interface from Vite; running it, use e.g. http://localhost:8000 or the
# HTTPS address of the reverse proxy in front of it.
FRONTEND_HOST=http://localhost:5173

# Development behaviour for commands run on this machine rather than in a
# container (pytest, scripts): placeholder secrets warn instead of failing.
# The development containers set it themselves.
FASTAPI_ENV=development

PROJECT_NAME="DataPlayer"

# Signs JWT access tokens. Rotating it only logs everyone out.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
SECRET_KEY=changethis

# Encrypts connector credentials at rest: urlsafe base64 of exactly 32 bytes.
# Kept separate from SECRET_KEY because rotating it requires migrating the
# stored secrets, while rotating SECRET_KEY does not.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
CONNECTOR_SECRET_KEY=changethis

# Encrypts what people write in query documents, and the text an execution
# ran: urlsafe base64 of exactly 32 bytes. Separate again, because changing it
# without migrating the stored content makes every document unreadable.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
QUERY_CONTENT_KEY=changethis
QUERY_HISTORY_SWEEP_SECONDS=3600

# Encrypts conversations with the agent and the model's working state: urlsafe
# base64 of exactly 32 bytes. Separate from the query key for the same reason.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AI_CONTENT_KEY=changethis

# How long one answer of the agent may take, in seconds, before it is stopped.
AI_RUN_TIMEOUT_SECONDS=900
# The most one answer may write, whatever the model could produce.
AI_MAX_OUTPUT_TOKENS=16000
# Older turns are summarised past this fraction of the model's context window,
# and this many of the newest messages are kept as they are.
AI_SUMMARY_TRIGGER_FRACTION=0.8
AI_SUMMARY_KEEP_MESSAGES=20
# Connections the model's working state may hold in the application database.
AI_CHECKPOINT_POOL_SIZE=4

# Holds one directory per user; a file connector never reaches outside it.
USER_STORAGE_ROOT=/data/users

# Where each process keeps its log as JSON lines beside standard output, rotated
# by size; the log panel reads it. Compose sets /app/logs on a volume of its own.
# Left unset, a process run natively writes to standard output alone.
# LOG_DIR=/app/logs
LOG_FILE_MAX_BYTES=10485760
# Files per process, the one being written included.
LOG_FILE_COUNT=5

# Ceiling for a single upload, in bytes. Counted as the bytes arrive.
MAX_UPLOAD_BYTES=104857600

# Transfers between connections one person may have running at once; one
# more is refused rather than queued out of sight.
TRANSFER_MAX_ACTIVE=3
# Pipelines one person may have running at once, refused the same way.
PIPELINE_MAX_ACTIVE=3
# How often, in seconds, the server looks for pipelines whose schedule has
# come; a scheduled run starts up to this late.
SCHEDULE_TICK_SECONDS=30
# How long converting a table with rows into a hypertable may run before it is
# rolled back; the table is locked against reads and writes meanwhile (D207).
TIMESCALE_CONVERSION_TIMEOUT_SECONDS=3600

# What one answer of the search may spend: seconds while typing, for each
# cheap and each costly place on Enter, and for all of them; how many
# connections it asks at most and at once; and the worker threads it may hold.
SEARCH_TYPING_SECONDS=0.4
SEARCH_CHEAP_SECONDS=2
SEARCH_COSTLY_SECONDS=10
SEARCH_TOTAL_SECONDS=20
SEARCH_MAX_CONNECTIONS=20
SEARCH_PARALLEL_CONNECTIONS=4
SEARCH_THREADS=4
# Keys a Redis server may hold and still be searched while typing; a larger
# one is searched on Enter. At most 1000000.
SEARCH_CHEAP_KEYS=20000
# A search inside files: seconds it may run over every connection chosen (at
# most 3600), and seconds its matches are held in memory once it ends (at
# most 7200).
SEARCH_CONTENTS_SECONDS=600
SEARCH_CONTENTS_HELD_SECONDS=1800

# Connections kept between requests, per process. A source with no connection
# at all — the file storage — ignores these.
POOL_MAX_SIZE=5
POOL_MAX_POOLS=20
POOL_MAX_IDLE_SECONDS=300

# Maximum cached catalog levels and fetch pages: per backend process in memory,
# or shared by the deployment in Redis. Sources choose their TTL independently.
DATA_CACHE_MAX_ENTRIES=512

# Where the read cache lives. The Compose stack starts a Redis for it, so this
# ships as `redis`; `memory` is the process-local baseline and is what a
# single-process deployment with no Redis should use. Redis needs all three of
# URL, deployment name and key, and the backend refuses to start without them.
DATA_CACHE_BACKEND=redis
# How long one Redis command may take before the read gives up on the cache
# and goes to the source instead.
DATA_CACHE_REDIS_TIMEOUT_SECONDS=1

# What the cache service asks for. The URL substitutes it rather than repeating
# it, so the two cannot drift apart — the same trick DATABASE_URL plays with
# POSTGRES_PASSWORD. Substitution is literal, so a password containing any of
# :/?#[]@ must be URL-encoded here.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_CACHE_REDIS_PASSWORD=changethis
DATA_CACHE_REDIS_URL=redis://:${DATA_CACHE_REDIS_PASSWORD}@redis-cache:6379/0
# External TLS + ACL example:
# DATA_CACHE_REDIS_URL=rediss://cache-user:password@cache.example.com:6380/0

# Which installation these entries belong to. It prefixes every key and names
# the invalidation channel, so two installations sharing one Redis under
# different names cannot see or invalidate each other's entries — and two under
# the same name deliberately share both. Changing it abandons the old entries
# to their TTL, which is the cheapest way to start from an empty cache.
# 1-63 letters, digits, dots, dashes or underscores, starting alphanumeric.
DATA_CACHE_DEPLOYMENT=development

# Seals disposable cache values: urlsafe base64 of exactly 32 bytes. Losing it
# costs nothing but a cold cache, so it is rotated freely.
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
DATA_CACHE_SECRET_KEY=changethis

# Read only by the backend test suite, and only from the real environment —
# pydantic-settings loads this file into settings, never into os.environ. The
# values below are the defaults, so a local run needs neither: the development
# Redis (`docker compose up -d redis`), database 15 so the tests never meet
# anything a person left in it, and the compatibility source v2_30_pg18, a
# TimescaleDB whose role may create databases. A test whose server does not
# answer is skipped: backend/tests/utils/services.py.
# TEST_REDIS_URL=redis://localhost:6379/15
# TEST_METRICS_STORE_URL=postgresql://fixture_admin:fixture-only@127.0.0.1:55431/postgres

# Where the metrics process receives agent datagrams (D127).
METRICS_UDP_HOST=0.0.0.0
METRICS_UDP_PORT=9999
# E2E only: opt in to the scenario that starts a managed TimescaleDB store.
# E2E_ALLOW_TIMESCALE_START=1
# Development only: the key of the agent seeded for the first superuser and
# used by the monitor-agent Compose profile. Leave empty to seed nothing.
METRICS_DEV_AGENT_KEY=

# Starting services on this machine. Off by default: a server that can reach a
# container runtime can do to the host whatever that runtime can.
SERVICES_ENABLED=false
DOCKER_SOCKET=/var/run/docker.sock
# The network a started service joins, and on which this server reaches it by
# container name. In development it is the one this compose project makes.
SERVICE_NETWORK=
# What one service may take of the machine, and how many one person may have.
SERVICE_MEMORY_MB=1024
SERVICE_CPUS=1.0
SERVICE_PIDS_LIMIT=512
SERVICE_MAX_PER_USER=5
# The named volume personal storage lives in; without it, backups are not
# offered, because a program in a container has nowhere to write one.
SERVICE_STORAGE_VOLUME=

# How long a socket may stay open without saying who it is.
WS_AUTH_TIMEOUT_SECONDS=5
# Watching the state of a user's connections: how often, how long a probe may
# take, how many at once, how far the wait grows after a failure, and how long
# the monitor outlives the last socket.
HEALTH_INTERVAL_SECONDS=15
HEALTH_PROBE_TIMEOUT_SECONDS=5
HEALTH_CONCURRENCY=8
HEALTH_BACKOFF_CAP_SECONDS=120
HEALTH_GRACE_SECONDS=5

FIRST_SUPERUSER=admin@example.com
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
FIRST_SUPERUSER_PASSWORD=changethis

# Email
SMTP_HOST=localhost
EMAILS_FROM_EMAIL=info@example.com
SMTP_TLS=False
SMTP_PORT=1025

# Postgres
# Generate: python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
POSTGRES_PASSWORD=changethis
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/app
